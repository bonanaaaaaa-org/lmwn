{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["VITE_*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "format:check": {},
    "type-check": {},
    "test": {
      "outputs": ["coverage/**"]
    }
  }
}
