{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "VITE_*"
  ],
  "globalPassThroughEnv": [
    "DEV_HOST"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "build/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "format:check": {},
    "type-check": {},
    "test": {
      "outputs": [
        "coverage/**"
      ]
    },
    "//#test:scripts": {
      "inputs": [
        "scripts/**"
      ]
    }
  }
}
