{
  "name": "api-gateway",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "run-p start:api-gw start:service",
    "start:api-gw": "uv run uvicorn app.main:app --reload --port 4000",
    "start:service": "node node_modules/lmwn-assignment-2025-server/main.js",
    "format": "uv run ruff format",
    "format:check": "uv run ruff format --check",
    "lint": "uv run ruff check",
    "lint:fix": "uv run ruff check --fix",
    "type-check": "uv run pyrefly check",
    "test": "uv run pytest --cov=app --cov-report=term-missing --tb=short"
  },
  "dependencies": {
    "lmwn-assignment-2025-server": "0.0.0-beta.1"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
