{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    // The newest ES level every browserslist target fully supports: ES2024 (Object.groupBy,
    // Promise.withResolvers and ArrayBuffer.transfer are in Safari 17.4; ES2025's Iterator helpers
    // only in Safari 18.4). Change it with the browserslist. Anything newer is a deliberate
    // polyfill decision (ESNext.Temporal: @/lib/temporal). See "Browser support" in
    // docs/design-decisions.md.
    "lib": ["ES2024", "ESNext.Temporal", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node",
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    ".storybook/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".react-router/types/**/*"
  ],
  "exclude": ["node_modules", "build", "coverage"]
}
