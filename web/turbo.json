{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["build/**"],
      "env": ["VITE_*"]
    },
    "type-check": {
      "dependsOn": ["gen:css-types"]
    },
    "gen:css-types": {
      "inputs": ["app/**/*.module.css", "src/**/*.module.css"],
      "outputs": ["app/**/*.module.css.d.ts", "src/**/*.module.css.d.ts"]
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "test": {
      "outputs": ["allure-results/unit/**"]
    },
    "test:scripts": {
      "inputs": ["scripts/**"],
      "outputs": []
    },
    "test:storybook": {
      "outputs": ["allure-results/storybook/**"],
      "env": ["VITE_*"]
    },
    "build-storybook": {
      "outputs": ["storybook-static/**"],
      "env": ["VITE_*"]
    }
  }
}
