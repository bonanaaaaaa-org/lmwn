{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "vite preview",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint && stylelint \"{app,src}/**/*.css\"",
    "lint:js": "oxlint",
    "lint:js:fix": "oxlint --fix",
    "lint:css": "stylelint \"{app,src}/**/*.css\"",
    "lint:css:fix": "stylelint \"{app,src}/**/*.css\" --fix",
    "gen:css-types": "tcm -p \"{app,src}/**/*.module.css\" --silent",
    "type-check": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "STORYBOOK=true storybook dev -p 6006 --no-open",
    "build-storybook": "STORYBOOK=true storybook build --quiet",
    "test:storybook": "STORYBOOK=true vitest run --config vitest.storybook.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@react-router/node": "^8.5.1",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "isbot": "^5.2.3",
    "modern-normalize": "^3.0.1",
    "react": "19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.1",
    "@react-router/fs-routes": "^8.5.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "msw": "^3.0.5",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "playwright": "^1.65.0",
    "storybook": "^10.6.7",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typed-css-modules": "^0.9.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
