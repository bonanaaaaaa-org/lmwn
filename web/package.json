{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "vite preview",
    "lint": "oxlint && stylelint \"{app,src}/**/*.css\"",
    "lint:js": "oxlint",
    "lint:js:fix": "oxlint --fix",
    "lint:css": "stylelint \"{app,src}/**/*.css\"",
    "lint:css:fix": "stylelint \"{app,src}/**/*.css\" --fix",
    "gen:css-types": "tcm -p \"{app,src}/**/*.module.css\" --silent",
    "type-check": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@react-router/node": "^7.18.1",
    "clsx": "^2.1.1",
    "modern-normalize": "^3.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "^7.18.1",
    "isbot": "^5"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.1",
    "@react-router/fs-routes": "^7.18.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.0.0",
    "msw": "^2.12.10",
    "oxlint": "1.74.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "typed-css-modules": "^0.9.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.10"
  }
}
