{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "vite preview",
    "lighthouse": "pnpm build && node scripts/lighthouse.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint && stylelint \"{app,src}/**/*.css\" && node scripts/check-ui-copy.mjs",
    "lint:js": "oxlint",
    "lint:js:fix": "oxlint --fix",
    "lint:css": "stylelint \"{app,src}/**/*.css\"",
    "lint:css:fix": "stylelint \"{app,src}/**/*.css\" --fix",
    "lint:copy": "node scripts/check-ui-copy.mjs",
    "gen:css-types": "tcm -p \"{app,src}/**/*.module.css\" --silent",
    "gen:i18n": "paraglide-js compile --project ./project.inlang --silent",
    "type-check": "pnpm gen:i18n && react-router typegen && tsc --noEmit",
    "test": "rm -rf allure-results/unit && vitest run --coverage",
    "test:watch": "vitest",
    "test:scripts": "node --test scripts/",
    "storybook": "STORYBOOK=true storybook dev -p 6006 --no-open",
    "build-storybook": "STORYBOOK=true storybook build --quiet",
    "test:storybook": "rm -rf allure-results/storybook && STORYBOOK=true vitest run --config vitest.storybook.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@fontsource/mali": "^5.3.0",
    "@react-router/node": "^8.5.1",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "isbot": "^5.2.3",
    "modern-normalize": "^3.0.1",
    "react": "19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.1",
    "react-router": "^8.5.1",
    "temporal-polyfill": "^1.0.8",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^3.2.2",
    "@inlang/plugin-message-format": "^4.6.0",
    "@react-router/dev": "^8.5.1",
    "@react-router/fs-routes": "^8.5.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "allure-vitest": "^3.14.0",
    "browserslist": "^4.29.5",
    "browserslist-to-esbuild": "^2.1.1",
    "chrome-launcher": "^1.2.3",
    "jsdom": "^31.0.0",
    "lighthouse": "^13.6.0",
    "msw": "^3.0.5",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "playwright": "^1.65.0",
    "storybook": "^10.6.7",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "typed-css-modules": "^0.9.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 ChromeAndroid versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "iOS >= 16.4",
    "Safari >= 16.4"
  ]
}
